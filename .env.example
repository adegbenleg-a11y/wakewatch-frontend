# ==============================================================================
# WakeWatch Front-End Environment Variables
# Bitnox Technology Solutions Ltd., Abeokuta
# ==============================================================================

# Backend API Base URL
# Point this to your backend teammate's running server (e.g., FastAPI, Node/Express, Flask)
VITE_API_URL=http://localhost:8000/api

# Mock Mode Switch
# Set to "true" to use built-in mock data for offline front-end development
# Set to "false" to connect to real backend endpoints
VITE_USE_MOCK=true

# Application Metadata
VITE_APP_NAME="WakeWatch"
VITE_COMPANY_NAME="Bitnox Technology Solutions"
VITE_LOCATION="Abeokuta, Ogun State, Nigeria"
VITE_PORT=3000
